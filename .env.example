# Copia este ficheiro para ".env" e preenche os valores reais.
# NUNCA commitar o ficheiro ".env" (já está no .gitignore).

# Servidor de entrada (IMAP)
IMAP_HOST=mail.procenter.co.ao
IMAP_PORT=993
IMAP_SECURE=true

# Credenciais da caixa de email
EMAIL_USER=recrutamento@procenter.co.ao
EMAIL_PASSWORD=

# Servidor de saída (SMTP) - reservado para uso futuro (envio de respostas)
SMTP_HOST=mail.procenter.co.ao
SMTP_PORT=465
SMTP_SECURE=true
